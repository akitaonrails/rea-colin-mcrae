#!/bin/sh
# The AppImage entry: the bundled Wine first on the PATH, then cmr-play
# (the settings window, then the game in gamescope when it is installed).
HERE=$(dirname "$(readlink -f "$0")")
export PATH="$HERE/usr/lib/wine/bin:$PATH"
export CMR_LAUNCHER="$HERE/usr/lib/cmr/CMRLauncher.exe"
# The AppImage is unmounted when this script ends: cmr-play waits for the game.
export CMR_WAIT=1
# No prompts to download Wine's .NET and HTML engines; the game needs neither.
export WINEDLLOVERRIDES="mscoree,mshtml=${WINEDLLOVERRIDES:+;$WINEDLLOVERRIDES}"
export WINEDEBUG="${WINEDEBUG:--all}"
exec "$HERE/usr/lib/cmr/cmr-play" "$@"
