#!/bin/sh
# Plays Colin McRae Rally on Linux through Wine and gamescope.
#
#   cmr-play           show the settings window, then start the game
#   cmr-play --play    start the game with the saved settings (no window);
#                      launcher flags may follow for one run, e.g.
#                      --scaler fsr --resolution 1280x960
#   cmr-play stop      end the game
#   cmr-play status    running or idle
#
# The settings window is CMRLauncher.exe's own (the same as on Windows),
# shown through Wine before gamescope starts. Settings live in launcher.cfg
# inside the Wine prefix, the gamescope scaler included.
#
# Optional environment:
#   CMR_PREFIX    Wine prefix       (default ~/.local/share/cmr-launcher/prefix)
#   CMR_LAUNCHER  CMRLauncher.exe   (default: next to this script, or one folder up)
#   CMR_RUN       a wrapper that runs wine and gamescope, e.g.
#                 "distrobox enter gaming --" when they live in a container
#   CMR_WAIT      set: wait for the game to end (the AppImage sets it)
#
# The session, GPU choice, Wine prefix and gamescope handling are the
# shared rea-launcher-sdk play library (rea-play.sh, beside this script in
# a package, else the repository's vendored sdk/); this script holds the
# game's own settings.
set -u

_fonly=${REA_FUNCTIONS_ONLY:-}
_here=$(dirname "$(readlink -f "$0")")
[ "$_fonly" = 1 ] && [ -n "${REA_PLAY_HERE:-}" ] && _here=$REA_PLAY_HERE
if [ -f "$_here/rea-play.sh" ]; then
  . "$_here/rea-play.sh"
elif [ -f "$_here/../sdk/rea-play.sh" ]; then
  . "$_here/../sdk/rea-play.sh"
else
  echo "rea-play.sh not found next to $0 or in ../sdk (run scripts/sdk-sync)" >&2
  exit 1
fi
REA_HERE=$_here REA_NAME=cmr-play

# The player-facing CMR_* names, mapped onto the library's settings.
REA_APP=cmr-launcher                  # ~/.config/cmr-launcher, the prefix name
REA_EXE_NAME=CMRLauncher.exe
REA_EXE_HINT=CMR_LAUNCHER
REA_EXE=${CMR_LAUNCHER:-}
REA_PREFIX=${CMR_PREFIX:-}
REA_RUN=${CMR_RUN:-}
# A launch returns at once (the lock remembers the session), unless
# CMR_WAIT asks to wait for the game.
REA_ALWAYS_WAIT=0
REA_WAIT=${CMR_WAIT:-}
# launcher.cfg: next to the launcher (a portable install or the AppImage),
# or in the prefix user's AppData\Local\CMRLauncher.
REA_CFG_APPDATA=CMRLauncher
# The race resolution replaces the game's 640x480; unset, original or off
# is the game's own 640x480, which gamescope then scales to the screen.
REA_DEFAULT_SIZE=640x480
REA_ORIGINAL_SIZE=640x480
REA_ORIGINAL_WORDS="original off"
# gamescope gets the game's size only (-w/-h) and fits it to the monitor,
# as cmr-play always did.
REA_GAMESCOPE_OUTPUT=0
# The 1998 game reads pads through WinMM (Wine's joystick driver); it
# never needed SDL settings of its own.
REA_SDL_ENV=
# The game's own DLLs are all it loads; the launcher adds its hook
# library in memory (no override needed).
REA_DLL_OVERRIDES=
# The launcher returns once the game is up: wait for the game itself.
REA_GAME_PROCS=Rally.exe

# `cmr-play --play --scaler fsr --resolution 1280x960`: flags for one run.
# The launcher reads them itself; the library lays the ones this script
# reads too (gamescope's size and filter) over launcher.cfg for this run
# only, never writing it. Look and resolution flags are read through
# REA_LOOK_SIZES.
REA_HELPER_KEYS="scaler"

# The race size a look gives (the launcher's form::Picture), when neither
# this run nor launcher.cfg names a resolution: Steam Deck 1280x800,
# Enhanced the screen, Original the game's 640x480. The library resolves
# them as the launcher does (form::with_look): a --resolution, else a
# --look, else the file's resolution, else its look.
REA_LOOK_SIZES="original=original enhanced=screen steam_deck=1280x800"

# The race is always landscape (the launcher's display::landscape): a
# rotated monitor gives its long side first; a screen xrandr can't read is
# 1920x1080 (not the game's 640x480). The library's own rea_screen_size,
# turned; until the SDK's has a landscape option.
rea_screen_size() {
  if [ -n "$REA_SCREEN" ]; then
    _cmr_s=$(rea_parse_size "$REA_SCREEN") || _cmr_s=1920x1080
  else
    _cmr_s=$(rea_parse_size "$(xrandr --current 2>/dev/null | awk '/\*/ { print $1; exit }')") || _cmr_s=1920x1080
  fi
  _cmr_w=${_cmr_s%x*} _cmr_h=${_cmr_s#*x}
  if [ "$_cmr_h" -gt "$_cmr_w" ]; then echo "${_cmr_h}x$_cmr_w"; else echo "$_cmr_s"; fi
}

rea_init || exit 1
# Tests load the configuration and functions without running anything.
[ "$_fonly" = 1 ] && return 0
rea_main "$@"
