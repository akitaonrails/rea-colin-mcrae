#!/bin/sh
# AppImage entry, generated by rea-launcher-sdk packaging/appimage-wine.sh
# from appimage/AppRun.in: bundled tools first, then @PLAY@ (the settings
# window, then the game).
HERE=$(dirname "$(readlink -f "$0")")
LIB=$HERE/usr/lib/@APP@
@WINE@# Portable Wine first on the PATH. The prefix is @PLAY@'s own
@WINE@# (@PREFIX@_PREFIX, default ~/.local/share/@APP@-launcher/prefix).
@WINE@export PATH="$HERE/usr/lib/wine/bin:$PATH"
@WINE@# No prompts to install Wine's .NET and HTML engines; the games need
@WINE@# neither. The player's own overrides still apply after ours.
@WINE@export WINEDLLOVERRIDES="mscoree,mshtml=${WINEDLLOVERRIDES:+;$WINEDLLOVERRIDES}"
@WINE@export WINEDEBUG="${WINEDEBUG:--all}"
@NATIVE@# Bundled programs first on the PATH, bundled libraries (if any) next.
@NATIVE@export PATH="$LIB:$PATH"
@NATIVE@if [ -d "$LIB/lib" ]; then
@NATIVE@  export LD_LIBRARY_PATH="$LIB/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
@NATIVE@fi
export @PREFIX@_LAUNCHER="$LIB/@EXE@"
# The AppImage is unmounted when this script ends: the helper waits.
export @PREFIX@_WAIT=1
@ENV@
exec "$LIB/@PLAY@" "$@"
